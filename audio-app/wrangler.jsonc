{
  // 社内音声配信アプリ (Cloudflare Workers + D1 + R2 + Cloudflare Access)
  // 詳しい手順は README.md を参照
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markeline-audio",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // workers.dev の直URLと preview URL は必ず無効化する（Access を経由しない入口を作らない）
  "workers_dev": false,
  "preview_urls": false,

  // 本番の入口はカスタムドメイン。Cloudflare Access のアプリケーションもこのドメインで作る
  // scripts/deploy.mjs が AUDIO_DOMAIN（既定 audio.lstepoffcial.com）で有効化する
  // "routes": [{ "pattern": "audio.lstepoffcial.com", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "audio_db",
      // `wrangler d1 create audio_db` の結果に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "AUDIO",
      // `wrangler r2 bucket create markeline-audio` で作る
      "bucket_name": "markeline-audio"
    }
  ],

  // 文字起こし（Whisper）と要約（LLM）に使う
  "ai": { "binding": "AI" },

  // 5 分おきに、公開済みで未処理の配信を 1 件ずつ文字起こし → 要約 → Notion 登録
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // アプリの URL（Notion に貼る「音声を聴く」リンクに使う）
    "APP_URL": "https://audio.lstepoffcial.com",
    // Notion 議事録DB の ID（AI秘書室 / 個人議事録DB）。トークンは secret の NOTION_TOKEN
    "NOTION_DATABASE_ID": "347af18b-85d6-4fe8-8fb9-6c0bd64a6ba4",
    "ENVIRONMENT": "production",
    // Cloudflare Zero Trust のチームドメイン（例: markeline.cloudflareaccess.com）
    "ACCESS_TEAM_DOMAIN": "",
    // Access アプリケーションの Audience (AUD) タグ
    "ACCESS_AUD": "",
    // 管理者のメールアドレス（カンマ区切り）。ここに載っている人は常に管理者
    "ADMIN_EMAILS": "fujiwara@markeline.net",
    // 1ファイルの上限（MB）
    "MAX_UPLOAD_MB": "200"
  },

  "observability": { "enabled": true }
}
